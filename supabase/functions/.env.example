# Server-side secrets for the whatsapp-webhook Edge Function.
# 1) Copy to supabase/functions/.env   (that file is git-ignored — never commit it)
# 2) Fill in the values on your own computer
# 3) npx supabase secrets set --env-file supabase/functions/.env
#
# To replace the expiring Meta test token later: edit ONLY the
# WHATSAPP_ACCESS_TOKEN line and run step 3 again. No redeploy needed.

# Any long random string you invent. Type the same value into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=

# Meta App → App settings → Basic → App secret
WHATSAPP_APP_SECRET=

# Meta → WhatsApp → API Setup → temporary access token (expires ~24h)
WHATSAPP_ACCESS_TOKEN=

# Meta → WhatsApp → API Setup → "Phone number ID" of the test number (not the phone number)
WHATSAPP_PHONE_NUMBER_ID=

# Your test phones, country code + number, comma separated. Spaces/+/- are fine.
WHATSAPP_ALLOWED_NUMBERS=+60 12-345 6789

# Optional
WHATSAPP_GRAPH_VERSION=v23.0

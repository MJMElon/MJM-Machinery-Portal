# Frontend (browser) values — copy to ".env" for `npm run dev`.
# Only PUBLIC values belong here. Find them in Supabase → Project Settings → API.
# Use the SAME Supabase project as MachTrek.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the Machinery module's "MachTrek" tile links to.
VITE_MACHTREK_URL=https://mjmelon.github.io/MachTrek/

# ------------------------------------------------------------------
# Do NOT put these here. They are Supabase Edge Function secrets, set with
# `supabase secrets set ...` (see README):
#   WHATSAPP_ACCESS_TOKEN, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN,
#   WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ALLOWED_NUMBERS, WHATSAPP_GRAPH_VERSION
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
